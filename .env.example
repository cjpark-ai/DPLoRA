# Environment variables for MT-Bench evaluation.
#
# Copy this file to `.env`, fill in your real values, then `source .env`.
# The real `.env` is gitignored; this template is committed so contributors
# know which variables are required.

# OpenAI API key — required for GPT-4 MT-Bench judgment.
# Get one at https://platform.openai.com/api-keys
export OPENAI_API_KEY="your-openai-api-key-here"

# Hugging Face token — optional; needed only for gated/private models.
# Get one at https://huggingface.co/settings/tokens
export HF_TOKEN="your-hf-token-here"
